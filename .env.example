# ==============================================================================
# ProPresenter Web Studio Controller - Environment Configuration Template
# Copy this file to .env and adjust values for your local church network
# ==============================================================================

# HTTP Web Server Port
PORT=8080

# Target ProPresenter 7+ Machine Network Configuration
PROPRESENTER_HOST=192.168.0.200
PROPRESENTER_PORT=1025

# Cloudflare D1 Bible Database Configuration
CLOUDFLARE_QUERY_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/d1/database/<DATABASE_ID>/query
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
